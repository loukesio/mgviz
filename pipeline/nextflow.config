manifest {
    name        = 'mgviz-pipeline'
    description = 'Virus detection from metagenomic reads with an interactive d3 report'
    version     = '0.1.0'
    nextflowVersion = '>=23.10'
}

params {
    samplesheet   = null
    db            = null          // directory holding virus_pathogen_database.{fna,mmi,all_metadata.tsv}
    filter_fasta  = null          // optional host / spike-in FASTA; null disables HOST_FILTER
    genomad_db    = null          // geNomad database directory; null skips GENOMAD
    genomad_splits = 0            // mmseqs2 DB splits; raise (e.g. 8) to cut memory on small machines
    predict_proteins = true
    outdir        = 'results'
    title         = 'mgviz report'
    container     = 'ghcr.io/loukesio/mgviz:0.1.0'   // one image for every process

    // standalone-module inputs (unused by main.nf)
    reads = null; sample = 'sample'; bam = null; refs = null; consensus = null; db_fasta = null
    db_table = null; db_name = null; taxdump = null; acc2taxid = null; db_outdir = 'db'
    stats = null; windows = null; adj = null; readcount = null; fastp_json = null; sample_dirs = null; samples_tsv = null

    // alignment filters (EsViritu defaults)
    min_aln_len   = 100
    min_read_cov  = 0.90
    min_identity  = 0.80
    mm_preset     = 'sr'          // minimap2 -x preset: sr | map-ont | map-hifi
    mm_k          = '500M'        // minimap2 -K batch size
    min_read_len  = 50

    // read-sharing clustering
    share_thresh  = 0.33

    // taxonomy profile thresholds
    sp_thresh     = 0.90
    subsp_thresh  = 0.95
}

process {
    cpus   = 4
    memory = '8 GB'
    time   = '4h'
    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy' ]
    withName: 'MAP_INITIAL|MAP_R2|MAP_R3'  { cpus = 8; memory = '16 GB' }
    withName: 'CLUSTER_R1' { ext.round = 'r1' }
    withName: 'CLUSTER_R2' { ext.round = 'r2' }
    withName: 'MAP_R2'     { ext.round = 'second' }
    withName: 'MAP_R3'     { ext.round = 'final' }
    withName: 'GENOMAD'                 { scratch = true }   // mmseqs2 cannot create its index on exFAT/virtiofs mounts
    withName: 'MGVIZ_REPORT'            { cpus = 1; memory = '2 GB'; publishDir = [ path: params.outdir, mode: 'copy' ] }
}

profiles {
    // Docker Desktop on a laptop: 8 CPU / 8 GB VM, so keep every task inside that
    laptop {
        params.container = 'ghcr.io/loukesio/mgviz:0.1.0-arm64'   // native on Apple silicon; drop for Intel Macs
        params.genomad_splits = 8                                    // geNomad's profile DB needs > 6 GB unsplit
        process.cpus = 4
        process.memory = '6 GB'
        process.maxForks = 2
        process.errorStrategy = { task.attempt < 3 ? 'retry' : 'terminate' }   // virtiofs on the external drive is occasionally stale
        process.maxRetries = 2
        process.'withName:MAP_INITIAL|MAP_R2|MAP_R3|GENOMAD' = [cpus: 6, memory: '6 GB', maxForks: 1]
    }
    // maintainer's laptop: everything heavy lives on an external drive
    external {
        workDir = '/Volumes/Untitled/mgviz/work'
        params.outdir = '/Volumes/Untitled/mgviz/results'
        params.db = '/Volumes/Untitled/mgviz/db/v3.2.4'
        params.genomad_db = '/Volumes/Untitled/mgviz/db/genomad_db'
    }
    docker { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)' }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    conda  { conda.enabled  = true;  process.conda = "${projectDir}/../environment.yml" }
    local  { executor.name  = 'local' }
    slurm  { executor.name  = 'slurm'; executor.queueSize = 50 }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
