/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    loukesio/mgviz Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {
    // Input / output
    samplesheet      = null
    db               = null
    outdir           = 'results'
    title            = 'mgviz report'

    // Optional steps
    filter_fasta     = null
    genomad_db       = null
    genomad_splits   = 0
    predict_proteins = true

    // Alignment filters (EsViritu defaults)
    min_aln_len      = 100
    min_read_cov     = 0.90
    min_identity     = 0.80
    min_read_len     = 50
    mm_preset        = 'sr'
    mm_k             = '500M'

    // Read-sharing clustering and taxonomy thresholds
    share_thresh     = 0.33
    sp_thresh        = 0.90
    subsp_thresh     = 0.95

    // Container used by every process
    container        = 'ghcr.io/loukesio/mgviz:0.1.0'

    // Resource limits (overridden by the base config / profiles)
    max_cpus         = 16
    max_memory       = '64.GB'
    max_time         = '48.h'

    // Standalone-module inputs (unused by the main workflow)
    reads = null; sample = 'sample'; bam = null; refs = null; consensus = null; db_fasta = null
    db_table = null; db_name = null; taxdump = null; acc2taxid = null; db_outdir = 'db'
    stats = null; windows = null; adj = null; readcount = null; fastp_json = null; sample_dirs = null; samples_tsv = null
}

// Parameter validation and --help (nf-schema reads nextflow_schema.json)
plugins { id 'nf-schema@2.2.0' }
validation {
    help {
        enabled = true
        command = "nextflow run loukesio/mgviz -profile docker --samplesheet samples.csv --db db/v3.2.4 --outdir results"
    }
    summary { hideParams = ['reads', 'sample', 'bam', 'refs', 'consensus', 'db_fasta', 'db_table', 'db_name', 'taxdump', 'acc2taxid', 'db_outdir', 'stats', 'windows', 'adj', 'readcount', 'fastp_json', 'sample_dirs', 'samples_tsv'] }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        process.conda          = "${projectDir}/environment.yml"
        docker.enabled         = false
        singularity.enabled    = false
    }
    local  { executor.name = 'local' }
    slurm  { executor.name = 'slurm'; executor.queueSize = 50; executor.submitRateLimit = '10 sec' }
    laptop { includeConfig 'conf/laptop.config' }
    test   { includeConfig 'conf/test.config' }
}

// Nextflow run metadata next to the results
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html" }

manifest {
    name            = 'loukesio/mgviz'
    author          = 'Loukas Theodosiou'
    homePage        = 'https://github.com/loukesio/mgviz'
    description     = 'Virus detection from metagenomic reads with an interactive d3 report'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}
