/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: where each process publishes, which alignment round it runs, extra args.
    ext.args overrides a tool's default flags; ext.prefix the output file prefix.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'CLUSTER_R1' { ext.round = 'r1' }
    withName: 'CLUSTER_R2' { ext.round = 'r2' }
    withName: 'MAP_R2'     { ext.round = 'second' }
    withName: 'MAP_R3'     { ext.round = 'final' }

    withName: 'GENOMAD' {
        scratch = true   // mmseqs2 cannot create its index on some network / exFAT mounts
    }
    withName: 'MGVIZ_REPORT' {
        publishDir = [ path: { params.outdir }, mode: 'copy', saveAs: { f -> f.equals('versions.yml') ? null : f } ]
    }
}
