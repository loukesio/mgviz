/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test profile: two tiny simulated samples against a 53-record database bundled with the
    pipeline (assets/test_data/). Runs in a few minutes on a laptop:
        nextflow run loukesio/mgviz -profile test,docker --outdir results_test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    samplesheet      = "${projectDir}/assets/test_data/samplesheet.csv"
    db               = "${projectDir}/assets/test_data/db"
    title            = 'mgviz test run'
    predict_proteins = true
    genomad_db       = null          // set to a geNomad database to exercise GENOMAD too
    max_cpus         = 4
    max_memory       = '8.GB'
    max_time         = '1.h'
}
