/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Laptop profile: Docker Desktop with a small VM (8 CPU / 8 GB). Keeps every task inside
    those limits, splits the geNomad database to cut memory, and retries tasks that fail
    because an external drive's view inside the VM is briefly stale.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    container      = 'ghcr.io/loukesio/mgviz:0.1.0-arm64'   // native on Apple silicon; use :0.1.0 on Intel
    genomad_splits = 8
    max_cpus       = 6
    max_memory     = '6.GB'
}

process {
    maxForks      = 2
    errorStrategy = { task.attempt < 3 ? 'retry' : 'terminate' }
    maxRetries    = 2
    withLabel: 'process_high' { cpus = 6; memory = '6.GB'; maxForks = 1 }
}
